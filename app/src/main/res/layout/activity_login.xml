<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:fillViewport="true" android:clipToPadding="false" android:background="@drawable/bg_soft_page">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:paddingLeft="26dp" android:paddingRight="26dp"
  android:paddingTop="28dp" android:paddingBottom="28dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:layout_width="39dp" android:layout_height="39dp" android:src="@drawable/ic_shop_logo" android:contentDescription="@string/app_name"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:text="ShopEase" android:textColor="@color/ink" android:fontFamily="sans-serif-black" android:textSize="23sp" android:letterSpacing="-0.02"/>
  <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_border_pill" android:paddingTop="9dp" android:paddingBottom="9dp" android:paddingLeft="13dp" android:paddingRight="13dp" android:text="MADE FOR YOU" android:textColor="@color/ink" android:textSize="9sp" android:letterSpacing="0.11" android:fontFamily="sans-serif-bold"/>
</LinearLayout>

 <LinearLayout android:layout_width="match_parent" android:layout_height="162dp"
   android:layout_marginTop="24dp" android:background="@drawable/bg_artboard"
   android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="24dp"
   android:paddingRight="8dp">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
     android:layout_weight="1" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="EVERYDAY EDIT" android:textColor="#8B5D33" android:textSize="10sp"
        android:fontFamily="sans-serif-bold" android:letterSpacing="0.18"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Little joys.\nBig smiles." android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-black" android:textColor="@color/ink"
        android:textSize="24sp" android:lineSpacingExtra="0dp"/>
   </LinearLayout>
   <pk.edu.nfciet.shopease.ShopArtworkView android:tag="hero"
     android:layout_width="156dp" android:layout_height="151dp"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="28dp" android:text="@string/welcome_back"
   android:textColor="@color/ink" android:textSize="33sp" android:fontFamily="sans-serif-black"
   android:letterSpacing="-0.035"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="5dp" android:text="@string/login_subtitle" android:textColor="@color/muted"
    android:textSize="13sp"/>
 <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail" style="@style/ShopTextField"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="@string/email"
            app:errorEnabled="false" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="58dp"
                android:inputType="textEmailAddress" android:maxLines="1"
                android:textColor="@color/ink" android:textColorHint="@color/muted"
                android:textSize="15sp" android:paddingLeft="8dp" android:paddingRight="8dp"/>
        </com.google.android.material.textfield.TextInputLayout>
 <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword" style="@style/ShopTextField"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="@string/password"
            app:errorEnabled="false" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="58dp"
                android:inputType="textPassword" android:maxLines="1"
                android:textColor="@color/ink" android:textColorHint="@color/muted"
                android:textSize="15sp" android:paddingLeft="8dp" android:paddingRight="8dp"/>
        </com.google.android.material.textfield.TextInputLayout>
 <TextView android:id="@+id/tvForgot" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:layout_gravity="right" android:padding="9dp" android:layout_marginTop="1dp"
   android:text="@string/forgot_password" android:textColor="@color/brand_navy"
   android:fontFamily="sans-serif-bold" android:textSize="12sp"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/btnLogin"
   android:layout_width="match_parent" android:layout_height="59dp"
   android:layout_marginTop="10dp" android:text="@string/log_in"
   android:textAllCaps="false" android:fontFamily="sans-serif-bold" android:textSize="16sp"
   android:textColor="@color/white" app:cornerRadius="19dp"
   app:backgroundTint="@color/brand_navy" app:icon="@drawable/ic_arrow_right"
   app:iconGravity="textEnd" app:iconPadding="16dp" app:iconTint="@color/white"/>
 <ProgressBar android:id="@+id/progress" android:layout_width="26dp" android:layout_height="26dp"
   android:layout_gravity="center_horizontal" android:layout_marginTop="9dp"
   android:indeterminateTint="@color/brand_orange" android:visibility="gone"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="25dp" android:gravity="center" android:orientation="horizontal">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:text="@string/no_account" android:textColor="@color/muted" android:textSize="13sp"/>
  <TextView android:id="@+id/tvGoToSignUp" android:layout_width="wrap_content" android:layout_height="wrap_content"
   android:padding="8dp" android:text="Sign up" android:textColor="@color/brand_navy"
   android:textSize="13sp" android:fontFamily="sans-serif-bold"/>
 </LinearLayout>
 </LinearLayout>
</ScrollView>
