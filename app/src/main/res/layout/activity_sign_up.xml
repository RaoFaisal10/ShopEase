<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:fillViewport="true" android:background="@drawable/bg_soft_page">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:paddingLeft="26dp" android:paddingRight="26dp"
  android:paddingTop="26dp" android:paddingBottom="27dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageView android:id="@+id/ivBack" android:layout_width="42dp" android:layout_height="42dp"
       android:padding="10dp" android:background="@drawable/bg_border_pill"
       android:src="@drawable/ic_arrow_back" android:contentDescription="Back to log in"/>
    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
       android:text="ShopEase" android:textColor="@color/ink" android:fontFamily="sans-serif-black"
       android:textSize="22sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp"
   android:orientation="horizontal" android:gravity="center_vertical">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
       android:text="LET’S GET STARTED" android:letterSpacing="0.16" android:fontFamily="sans-serif-bold"
       android:textColor="#A87832" android:textSize="10sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
       android:layout_marginTop="9dp" android:text="Create your\naccount." android:textColor="@color/ink"
       android:fontFamily="sans-serif-black" android:textSize="35sp" android:letterSpacing="-0.035"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
       android:layout_marginTop="7dp" android:text="@string/create_subtitle"
       android:textColor="@color/muted" android:textSize="13sp"/>
   </LinearLayout>
   <FrameLayout android:layout_width="108dp" android:layout_height="108dp" android:background="@drawable/bg_cream_card">
     <ImageView android:layout_width="82dp" android:layout_height="82dp" android:layout_gravity="center"
      android:src="@drawable/ic_shop_logo" android:contentDescription="@string/app_name"/>
   </FrameLayout>
  </LinearLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp"
    android:text="YOUR DETAILS" android:textColor="@color/ink" android:letterSpacing="0.16"
    android:textSize="10sp" android:fontFamily="sans-serif-bold"/>
  <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName" style="@style/ShopTextField"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="@string/full_name"
            app:errorEnabled="false" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="58dp"
                android:inputType="textPersonName" android:maxLines="1"
                android:textColor="@color/ink" android:textColorHint="@color/muted"
                android:textSize="15sp" android:paddingLeft="8dp" android:paddingRight="8dp"/>
        </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail" style="@style/ShopTextField"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="@string/email"
            app:errorEnabled="false" >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="58dp"
                android:inputType="textEmailAddress" android:maxLines="1"
                android:textColor="@color/ink" android:textColorHint="@color/muted"
                android:textSize="15sp" android:paddingLeft="8dp" android:paddingRight="8dp"/>
        </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword" style="@style/ShopTextField"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="@string/password"
            app:errorEnabled="false" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="58dp"
                android:inputType="textPassword" android:maxLines="1"
                android:textColor="@color/ink" android:textColorHint="@color/muted"
                android:textSize="15sp" android:paddingLeft="8dp" android:paddingRight="8dp"/>
        </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirm" style="@style/ShopTextField"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="@string/confirm_password"
            app:errorEnabled="false" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirm" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="58dp"
                android:inputType="textPassword" android:maxLines="1"
                android:textColor="@color/ink" android:textColorHint="@color/muted"
                android:textSize="15sp" android:paddingLeft="8dp" android:paddingRight="8dp"/>
        </com.google.android.material.textfield.TextInputLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp"
   android:text="@string/password_helper" android:textColor="@color/muted" android:textSize="11sp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/btnSignUp"
   android:layout_width="match_parent" android:layout_height="59dp"
   android:layout_marginTop="21dp" android:text="@string/sign_up"
   android:textAllCaps="false" android:fontFamily="sans-serif-bold" android:textSize="16sp"
   android:textColor="@color/white" app:cornerRadius="19dp" app:backgroundTint="@color/brand_navy"
   app:icon="@drawable/ic_arrow_right" app:iconGravity="textEnd" app:iconPadding="16dp" app:iconTint="@color/white"/>
  <ProgressBar android:id="@+id/progress" android:layout_width="26dp" android:layout_height="26dp"
    android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
    android:indeterminateTint="@color/brand_orange" android:visibility="gone"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
   android:layout_marginTop="19dp" android:orientation="horizontal">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
     android:text="@string/have_account" android:textColor="@color/muted" android:textSize="13sp"/>
   <TextView android:id="@+id/tvGoToLogin" android:layout_width="wrap_content" android:layout_height="wrap_content"
     android:text="Log in" android:textColor="@color/brand_navy" android:textSize="13sp"
     android:fontFamily="sans-serif-bold" android:padding="8dp"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
